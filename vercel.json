{
  "buildCommand": "cd rxscan && npm run build",
  "outputDirectory": "rxscan/build",
  "installCommand": "cd rxscan && npm install",
  "framework": "create-react-app",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
